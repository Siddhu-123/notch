    "Add playback controls, lyrics, and music shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add playback controls, lyrics, and music shortcuts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt Wiedergabesteuerung, Liedtexte und Musik-Kurzbefehle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade controles de reproducción, letras y atajos de música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des commandes de lecture, des paroles et des raccourcis musicaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge controlli di riproduzione, testi e scorciatoie musicali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生操作、歌詞、音楽ショートカットを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 제어, 가사 및 음악 단축키를 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona controles de reprodução, letras e atalhos de música."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет управление воспроизведением, тексты песен и сочетания клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加播放控制、歌词和音乐快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入播放控制、歌詞和音樂快速鍵。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt afspeelbediening, songteksten en muzieksneltoetsen toe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma denetimleri, şarkı sözleri ve müzik kestirmeleri ekler."
          }
        }
      }
    },
