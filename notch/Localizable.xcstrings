    "Notch uses Accessibility to control windows and keyboard actions, and never grants this permission itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch uses Accessibility to control windows and keyboard actions, and never grants this permission itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch nutzt Bedienungshilfen für Fenster- und Tastaturaktionen und erteilt diese Berechtigung niemals selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Accesibilidad para controlar ventanas y acciones del teclado, y nunca concede este permiso por sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch utilise l’accessibilité pour gérer les fenêtres et les actions clavier, et n’accorde jamais elle-même cette autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Accessibilità per controllare finestre e azioni da tastiera e non concede mai autonomamente questa autorizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchはウインドウとキーボード操作にアクセシビリティを使い、この権限を自ら許可することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch는 윈도우와 키보드 동작에 손쉬운 사용을 쓰며 이 권한을 직접 허용하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notch usa Acessibilidade para controlar janelas e ações do teclado e nunca concede essa permissão por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch использует универсальный доступ для управления окнами и клавиатурой и никогда не выдаёт это разрешение самостоятельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用辅助功能控制窗口和键盘操作，且不会自行授予此权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用輔助使用來控制視窗和鍵盤操作，且不會自行授予此權限。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch gebruikt toegankelijkheid voor venster- en toetsenbordacties en verleent deze toestemming nooit zelf."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch, pencereleri ve klavye eylemlerini denetlemek için Erişilebilirlik’i kullanır ve bu izni kendisi vermez."
          }
        }
      }
    },
    "Notch uses Input Monitoring to detect selected keyboard and mouse shortcuts, and never grants this permission itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch uses Input Monitoring to detect selected keyboard and mouse shortcuts, and never grants this permission itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch nutzt Eingabeüberwachung für ausgewählte Tastatur- und Mauskürzel und erteilt diese Berechtigung niemals selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Supervisión de entrada para detectar atajos elegidos de teclado y ratón, y nunca concede este permiso por sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch utilise la surveillance de la saisie pour détecter les raccourcis choisis, et n’accorde jamais elle-même cette autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Monitoraggio input per rilevare le scorciatoie scelte e non concede mai autonomamente questa autorizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchは選択したキーボードとマウスのショートカット検出に入力監視を使い、この権限を自ら許可することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch는 선택한 키보드와 마우스 단축키를 감지하는 데 입력 모니터링을 쓰며 이 권한을 직접 허용하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notch usa Monitoramento de Entrada para detectar atalhos escolhidos e nunca concede essa permissão por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch использует мониторинг ввода для выбранных сочетаний клавиш и мыши и никогда не выдаёт это разрешение самостоятельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用输入监控来检测选定的键盘和鼠标快捷键，且不会自行授予此权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用輸入監控來偵測選取的鍵盤和滑鼠快速鍵，且不會自行授予此權限。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch gebruikt invoercontrole om gekozen toetsenbord- en muissneltoetsen te detecteren en verleent deze toestemming nooit zelf."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch, seçili klavye ve fare kestirmelerini algılamak için Giriş İzleme’yi kullanır ve bu izni kendisi vermez."
          }
        }
      }
    },
    "Notch uses Screen Recording to capture screenshots and watch a selected region, and never grants this permission itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch uses Screen Recording to capture screenshots and watch a selected region, and never grants this permission itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch nutzt Bildschirmaufnahme für Bildschirmfotos und die Überwachung eines ausgewählten Bereichs und erteilt diese Berechtigung niemals selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Grabación de pantalla para capturar pantallas y vigilar una zona elegida, y nunca concede este permiso por sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch utilise l’enregistrement de l’écran pour capturer des images et surveiller une zone choisie, et n’accorde jamais elle-même cette autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Registrazione schermo per acquisire schermate e monitorare un’area scelta e non concede mai autonomamente questa autorizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchはスクリーンショット撮影と選択領域の監視に画面収録を使い、この権限を自ら許可することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch는 스크린샷과 선택 영역 감시에 화면 기록을 쓰며 이 권한을 직접 허용하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notch usa Gravação de Tela para capturar imagens e monitorar uma região escolhida e nunca concede essa permissão por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch использует запись экрана для снимков и наблюдения за выбранной областью и никогда не выдаёт это разрешение самостоятельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用屏幕录制来截屏和监视选定区域，且不会自行授予此权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用螢幕錄製來擷取畫面並監看選取區域，且不會自行授予此權限。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch gebruikt schermopname voor schermafbeeldingen en het bewaken van een gekozen gebied en verleent deze toestemming nooit zelf."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch, ekran görüntüsü almak ve seçili bir bölgeyi izlemek için Ekran Kaydı’nı kullanır ve bu izni kendisi vermez."
          }
        }
      }
    },
    "Notch uses System Audio Recording to read playback for app audio tools, and never grants this permission itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch uses System Audio Recording to read playback for app audio tools, and never grants this permission itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch nutzt Systemaudioaufnahme, um Wiedergabe für App-Audiowerkzeuge zu lesen, und erteilt diese Berechtigung niemals selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Grabación de audio del sistema para leer la reproducción de herramientas de audio, y nunca concede este permiso por sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch utilise l’enregistrement audio système pour lire le son des outils audio, et n’accorde jamais elle-même cette autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Registrazione audio di sistema per leggere la riproduzione degli strumenti audio e non concede mai autonomamente questa autorizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchはアプリ音声ツールの再生音を読み取るためシステムオーディオ収録を使い、この権限を自ら許可することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch는 앱 오디오 도구에서 재생음을 읽기 위해 시스템 오디오 기록을 쓰며 이 권한을 직접 허용하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notch usa Gravação de Áudio do Sistema para ler a reprodução nas ferramentas de áudio e nunca concede essa permissão por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch использует запись системного аудио для чтения воспроизведения в аудиоинструментах и никогда не выдаёт это разрешение самостоятельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用系统音频录制来读取应用音频工具的播放内容，且不会自行授予此权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用系統音訊錄製來讀取 App 音訊工具的播放內容，且不會自行授予此權限。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch gebruikt systeemgeluidsopname om audio voor app-tools te lezen en verleent deze toestemming nooit zelf."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch, uygulama ses araçlarının çalmayı okuması için Sistem Ses Kaydı’nı kullanır ve bu izni kendisi vermez."
          }
        }
      }
    },
    "Notch uses Automation only for actions you choose in other apps, and never grants this permission itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch uses Automation only for actions you choose in other apps, and never grants this permission itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch nutzt Automation nur für Aktionen, die du in anderen Apps auswählst, und erteilt diese Berechtigung niemals selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Automatización solo para acciones que eliges en otras apps, y nunca concede este permiso por sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch utilise l’automatisation uniquement pour les actions choisies dans d’autres apps, et n’accorde jamais elle-même cette autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Automazione solo per le azioni scelte in altre app e non concede mai autonomamente questa autorizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchは他のアプリで選択した操作にのみオートメーションを使い、この権限を自ら許可することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch는 다른 앱에서 선택한 동작에만 자동화를 쓰며 이 권한을 직접 허용하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notch usa Automação apenas para ações escolhidas em outros apps e nunca concede essa permissão por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch использует автоматизацию только для выбранных действий в других приложениях и никогда не выдаёт это разрешение самостоятельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 仅对你选择的其他应用操作使用自动化，且不会自行授予此权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 只會對你在其他 App 中選擇的動作使用自動化，且不會自行授予此權限。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch gebruikt automatisering alleen voor acties die je in andere apps kiest en verleent deze toestemming nooit zelf."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch, diğer uygulamalarda seçtiğiniz eylemler için Otomasyon’u kullanır ve bu izni kendisi vermez."
          }
        }
      }
    },
    "Notch uses Full Disk Access to review protected folders during maintenance scans, and never grants this permission itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch uses Full Disk Access to review protected folders during maintenance scans, and never grants this permission itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch nutzt Vollzugriff, um geschützte Ordner bei Wartungsscans zu prüfen, und erteilt diese Berechtigung niemals selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Acceso total al disco para revisar carpetas protegidas durante análisis de mantenimiento, y nunca concede este permiso por sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch utilise l’accès complet au disque pour examiner les dossiers protégés lors des analyses de maintenance, et n’accorde jamais elle-même cette autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch usa Accesso completo al disco per esaminare cartelle protette durante le scansioni di manutenzione e non concede mai autonomamente questa autorizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchはメンテナンススキャンで保護フォルダを確認するためフルディスクアクセスを使い、この権限を自ら許可することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch는 유지 관리 검사 중 보호된 폴더를 살펴보려고 전체 디스크 접근을 쓰며 이 권한을 직접 허용하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notch usa Acesso Completo ao Disco para revisar pastas protegidas em verificações de manutenção e nunca concede essa permissão por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch использует полный доступ к диску для проверки защищённых папок при обслуживании и никогда не выдаёт это разрешение самостоятельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用完全磁盘访问权限在维护扫描期间查看受保护文件夹，且不会自行授予此权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch 使用完整磁碟取用權限在維護掃描期間檢視受保護資料夾，且不會自行授予此權限。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch gebruikt volledige schijftoegang om beschermde mappen bij onderhoudsscans te bekijken en verleent deze toestemming nooit zelf."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch, bakım taramalarında korumalı klasörleri incelemek için Tam Disk Erişimi’ni kullanır ve bu izni kendisi vermez."
          }
        }
      }
    }
  },
  "version": "1.0"
}
